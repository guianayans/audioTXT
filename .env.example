# Copie para .env ou cadastre estas variáveis no Coolify. Nunca versione o .env.

# —— Senha de acesso à página (OBRIGATÓRIO) ——
# Sem senha definida, a página fica aberta (um aviso aparece na tela).
AUDIOTXT_PASSWORD=""
# Segredo p/ assinar o cookie de sessão. Gere com: openssl rand -hex 32
AUDIOTXT_SESSION_SECRET=""
# Duração da sessão em horas (padrão 72). Cookie seguro (HTTPS) por padrão.
AUDIOTXT_SESSION_HOURS=72
AUDIOTXT_COOKIE_SECURE=true

# —— Modelo e dispositivo ——
# Opções: tiny | base | small | medium | large-v3-turbo | large-v3
# large-v3-turbo é o recomendado p/ uma GPU de 16 GB (rápido e preciso).
AUDIOTXT_DEFAULT_MODEL=large-v3-turbo
# auto (GPU com fallback p/ CPU) | cpu (força CPU)
AUDIOTXT_DEVICE=auto

# —— GPU (normalmente não precisa mexer) ——
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
